<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FillButtonStyle" parent="@style/Widget.MaterialComponents.Button">
        <item name="cornerRadius">5dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="android:layout_height">60dp</item>
    </style>
    <style name="StrokeButtonStyle" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">5dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/green_accent</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="android:layout_height">55dp</item>

    </style>



    <style name="EditTextStyle" parent="@style/Widget.AppCompat.TextView">
        <item name="android:background">@drawable/bg_square_box</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">10dp</item>
        <item name="android:inputType">text</item>
        <item name="android:drawablePadding">5dp</item>
    </style>


    <style name="ToolBarStyle" parent="@style/Widget.AppCompat.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">50dp</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>